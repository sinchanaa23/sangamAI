# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Language model for the Buyer, Supplier and Auditor agents, Ask Sangam and certificate reading. Any OpenAI-compatible API works; pick one:
#   Groq (free tier):    LLM_BASE_URL=https://api.groq.com/openai/v1                       LLM_MODEL=openai/gpt-oss-120b
#   Gemini (free tier):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   OpenRouter (:free):  LLM_BASE_URL=https://openrouter.ai/api/v1                          LLM_MODEL=<a :free model id>
# Free tiers change their limits; check the provider's console. With no LLM_API_KEY negotiations play back the recorded demo.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional: a stronger model for the Auditor only
LLM_AUDITOR_MODEL=

PORT=8787

# Optional: a model that accepts images, for reading uploaded certificates (defaults to LLM_MODEL).
# Gemini Flash reads images and PDFs. Groq's gpt-oss models are text-only; use a Groq vision model or switch LLM_MODEL to Gemini.
LLM_VISION_MODEL=

# Optional: Bhashini speech and translation (server/bhashini.ts)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
