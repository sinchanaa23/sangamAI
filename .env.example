# Copy to .env.local (git-ignored) and fill in. Never commit real keys, and never paste them in chat or screenshots.

# Language model for the Buyer, Supplier and Auditor agents, Ask Sangam and certificate reading.
# Any OpenAI-compatible API works. Free tiers allow only a few requests a minute, so pick a fast model and set LLM_RPM.
#   Gemini (aistudio.google.com/apikey):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#       Each model has its own free quota. gemini-2.5-flash allowed only 5 requests a minute; gemini-3.1-flash-lite allowed 14+ in testing.
#       List what your key can use:  curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models
#   Groq (console.groq.com):              LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=openai/gpt-oss-120b  (text only)
#   OpenRouter (:free models):            LLM_BASE_URL=https://openrouter.ai/api/v1
# With no LLM_API_KEY, negotiations play back the recorded demo.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
# Requests per minute the provider allows; calls are spaced to stay under it (leave a little spare). 0 or empty = no spacing.
LLM_RPM=14
# Optional: a stronger model for the Auditor, and a model that accepts images for reading certificates.
LLM_AUDITOR_MODEL=gemini-3.5-flash
LLM_VISION_MODEL=gemini-3.5-flash
# Optional: read certificates on a different provider than the agents.
# LLM_VISION_BASE_URL=
# LLM_VISION_API_KEY=

PORT=8790

# Optional: Bhashini speech and translation (server/bhashini.ts)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
