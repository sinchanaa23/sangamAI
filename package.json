{
  "name": "sangam",
  "private": true,
  "version": "0.1.0",
  "description": "Sangam - AI supply-chain intelligence and domestic localization platform (SAP Hackfest 2026 prototype)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm run server\"",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "data:refresh": "node scripts/fetch-real-data.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "javascript-lp-solver": "^0.4.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@hono/node-server": "^2.1.5",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "hono": "^4.13.13",
    "mapshaper": "^0.7.95",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
